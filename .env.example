# Katip Meet: copy to .env; never commit secrets.
# Values below are source defaults unless marked installation-specific.
# See docs/configuration.md and docs/getting-started.md.
# JSON and scrypt values use single quotes to prevent Compose interpolation.

# LLM, speech providers and failover
# Anthropic credential; used only on the server.
ANTHROPIC_API_KEY=
# Report and general LLM model identifier; confirm account availability.
KATIP_LLM_MODEL=claude-sonnet-5-5
# Live agent model identifier.
KATIP_AGENT_MODEL=claude-sonnet-5-5
# Live Anthropic reasoning effort.
KATIP_AGENT_EFFORT=low
# Enable adaptive thinking on supported live calls.
KATIP_AGENT_THINKING=true
# Enable thinking on supported report calls.
KATIP_REPORT_THINKING=true
# Use Anthropic batches for end-of-meeting reports; interim reports remain immediate.
KATIP_REPORT_BATCH=true
# Batch wait limit in seconds before immediate generation fallback.
KATIP_REPORT_BATCH_MAX_WAIT_S=1200
# Ordered nonempty live LLM provider chain; duplicates rejected.
KATIP_LLM_LIVE_CHAIN='["anthropic"]'
# Ordered nonempty report LLM provider chain; duplicates rejected.
KATIP_LLM_REPORT_CHAIN='["anthropic"]'
# Ordered speech provider chain; empty uses stt_provider.
KATIP_STT_CHAIN='[]'
# Total live provider time budget in seconds; positive.
KATIP_PROVIDER_DEADLINE_S=60.0
# Initial provider attempt limit in seconds; positive.
KATIP_PROVIDER_ATTEMPT_TIMEOUT_S=20.0
# Total report call time budget in seconds; positive.
KATIP_REPORT_DEADLINE_S=600.0
# Initial report attempt limit in seconds; positive.
KATIP_REPORT_ATTEMPT_TIMEOUT_S=120.0
# AWS runtime region; must start with eu- when Bedrock is selected.
KATIP_BEDROCK_REGION=eu-central-1
# Optional AWS profile name; otherwise use the SDK credential chain.
KATIP_BEDROCK_AWS_PROFILE=
# Legacy EU inference-profile selection retained for compatibility.
KATIP_BEDROCK_INFERENCE_PROFILE=eu
# Prefix added to the configured model for Bedrock runtime.
KATIP_BEDROCK_MODEL_PREFIX=eu.anthropic.
# Per-workload complete model IDs overriding the prefix: live, translation, report.
KATIP_BEDROCK_MODEL_IDS='{}'
# Google Cloud project for the Vertex adapter; credentials use ADC.
KATIP_VERTEX_PROJECT=
# Vertex multi-region; only eu is accepted.
KATIP_VERTEX_REGION=eu
# Provider/model/region pricing overrides in USD per million tokens.
KATIP_PROVIDER_LLM_PRICES='{}'
# USD per audio hour, keyed by provider/model/region.
KATIP_PROVIDER_STT_PRICES='{}'
# AssemblyAI credential for the optional speech adapter.
ASSEMBLYAI_API_KEY=
# AssemblyAI region; only eu is accepted.
KATIP_ASSEMBLYAI_REGION=eu

# Agent turns and spoken-response floor
# llm uses tool calls; rules uses deterministic commands. Missing LLM key also limits agent behavior.
KATIP_AGENT_MODE=llm
# Quiet wait after an addressed utterance in seconds.
KATIP_AGENT_TURN_WAIT_S=1.5
# Longer wait for an apparently unfinished addressed utterance.
KATIP_AGENT_INCOMPLETE_WAIT_S=6.0
# Maximum duration of an addressed turn before handling.
KATIP_AGENT_TURN_MAX_S=120.0
# Recent-speech window used by spoken-response floor control.
KATIP_VOICE_BUSY_WINDOW_S=1.2
# Wait for an opportunity to speak.
KATIP_VOICE_FLOOR_WAIT_S=2.0
# Ambient speech window used by floor control.
KATIP_VOICE_AMBIENT_WINDOW_S=1.5
# Sustained interruption duration before speech is interrupted.
KATIP_VOICE_INTERRUPT_SUSTAIN_S=1.2
# Quiet interval before resuming spoken output.
KATIP_VOICE_RESUME_QUIET_S=1.2

# Content, reports and legacy voice identity
# Optional installation company name for reports and notices; privacy fallback is Şirket.
# KATIP_COMPANY_NAME=
# Persistent meeting files directory, including reports and requested screenshots.
KATIP_DATA_DIR=data
# Base64-encoded 32-byte content master key; keep outside source control.
KATIP_DATA_KEY=
# Content-key file path; takes precedence over data_key.
KATIP_DATA_KEY_FILE=
# Previous base64 master key during rewrapping; never remove until rotation is verified.
KATIP_DATA_KEY_PREVIOUS=
# Fail closed when a valid meeting-content key is unavailable.
KATIP_REQUIRE_ENCRYPTION=false
# Natural-language report language.
KATIP_REPORT_LANG=Türkçe
# Include transcript in the Word report attachment.
KATIP_REPORT_INCLUDE_TRANSCRIPT=true
# Also include transcript in the PDF report.
KATIP_REPORT_TRANSCRIPT_PDF=false
# Time zone used to display report times; server timestamps use UTC.
KATIP_TIMEZONE=Europe/Istanbul
# Generate an end-of-meeting report automatically.
KATIP_AUTO_REPORT=true
# Legacy voice-identity switch; MeetingSession does not enable biometrics.
KATIP_VOICE_ENABLED=false
# Legacy speaker-embedding model identifier.
KATIP_VOICE_MODEL=wespeaker-resnet34-lm
# Legacy minimum embedding similarity for a match.
KATIP_VOICE_MATCH_THRESHOLD=0.55
# Legacy separation required between candidate matches.
KATIP_VOICE_MATCH_MARGIN=0.08
# Legacy minimum voice enrollment audio in seconds.
KATIP_VOICE_MIN_ENROLL_S=8.0
# Legacy recognized-person greeting mode: chat or off.
KATIP_GREETING=chat
# Optional local legacy embedding model path; otherwise model cache is under data_dir.
# KATIP_VOICE_MODEL_PATH=

# Reply and speech synthesis
# Default chat or voice replies; recording mode limits voice/translation.
KATIP_REPLY_MODE=chat
# Soniox real-time speech synthesis model identifier.
KATIP_TTS_MODEL=tts-rt-v2
# Soniox voice identifier; availability depends on provider account.
KATIP_TTS_VOICE=Rania
# Soniox speech synthesis WebSocket URL; EU mode rewrites the host.
KATIP_TTS_WS_URL=wss://tts-rt.soniox.com/tts-websocket
# Synthesized audio sample rate in Hz.
KATIP_TTS_SAMPLE_RATE=48000
# Turkish normalization backend: auto, ntr or katip; failures fall back locally.
KATIP_TTS_NORMALIZER=auto
# Installation pronunciation map applied before TTS; empty by default.
KATIP_TTS_LEXICON='{}'

# Administration, Microsoft and calendar
# Bearer credential for management API; empty disables bearer-authorized management.
KATIP_ADMIN_TOKEN=
# Bootstrap panel scrypt hash; database override takes precedence.
KATIP_ADMIN_PASSWORD_HASH=
# Exact allowed panel account domains; empty by default, configure explicitly.
KATIP_PANEL_EMAIL_DOMAINS='[]'
# Explicit bootstrap login email within an allowed domain.
KATIP_ADMIN_LOGIN_EMAIL=
# Microsoft Entra tenant identifier for Graph integration.
KATIP_M365_TENANT_ID=
# Microsoft application/client identifier for Graph integration.
KATIP_M365_CLIENT_ID=
# Microsoft Graph application secret.
KATIP_M365_CLIENT_SECRET=
# Installation calendar/mail mailbox address; empty by default.
KATIP_M365_MAILBOX=
# Enable approved meeting-note email sending.
KATIP_MAIL_ENABLED=false
# Comma-separated exact domains used by internal-mail checks; empty uses configured identity rules.
KATIP_MAIL_INTERNAL_DOMAINS=
# Microsoft Bot application UUID for Teams messaging.
KATIP_TEAMS_BOT_APP_ID=
# Teams bot client secret; keep out of repository and logs.
KATIP_TEAMS_BOT_SECRET=
# Teams bot secret file path.
KATIP_TEAMS_BOT_SECRET_FILE=
# Tenant accepted by Teams bot authentication.
KATIP_TEAMS_BOT_TENANT_ID=
# Enable Teams notifications where the integration is configured.
KATIP_TEAMS_NOTIFY=true
# Explicit Teams package UUID; otherwise derived from bot app ID using a neutral namespace.
KATIP_TEAMS_APP_PACKAGE_ID=
# HTTPS privacy policy URL in generated Teams manifest; falls back to public base /gizlilik.
KATIP_TEAMS_PRIVACY_URL=
# HTTPS terms URL in generated Teams manifest; falls back to public base /gizlilik.
KATIP_TEAMS_TERMS_URL=
# Legacy switch: selects güvenilir only when calendar_join_policy is not explicitly set.
KATIP_CALENDAR_AUTOJOIN=false
# kapalı disables, onay requires review, güvenilir permits trusted organizers, hepsi permits eligible invitations.
KATIP_CALENDAR_JOIN_POLICY=kapalı
# Maximum automatic calendar joins per day, 0–1000.
KATIP_CALENDAR_DAILY_AUTOJOINS=20
# Persistent calendar queue cap, 1–1000; default 200.
KATIP_CALENDAR_MAX_PENDING=200
# Calendar polling interval, 30–3600 seconds.
KATIP_CALENDAR_POLL_S=60
# Exact trusted ASCII domains, no wildcard or subdomain inheritance; empty by default, at most 100.
KATIP_CALENDAR_ORGANIZER_DOMAINS='[]'
# Normalized trusted full email addresses; empty by default, at most 200.
KATIP_CALENDAR_ORGANIZER_EMAILS='[]'
# Panel idle session lifetime in minutes.
KATIP_ADMIN_IDLE_MINUTES=60
# Maximum panel session age in hours.
KATIP_ADMIN_SESSION_HOURS=12
# Send panel cookies only over HTTPS; keep true outside isolated local development.
KATIP_ADMIN_COOKIE_SECURE=true
# Client-IP strategy: last x-forwarded-for value, or trusted-proxy cf-connecting-ip.
KATIP_CLIENT_IP_HEADER=x-forwarded-for
# Exact proxy IPs trusted in Cloudflare mode; configure actual TCP peers.
KATIP_CLIENT_IP_TRUSTED_PROXIES='["127.0.0.1","::1"]'
# Signing secret for links; if empty derives from admin_token. Set explicitly and back it up securely.
KATIP_SECRET_KEY=
# Signed panel/report link validity in days.
KATIP_SHARE_LINK_DAYS=7.0
# Public HTTPS origin used for generated links; set explicitly on-premises.
KATIP_PUBLIC_BASE_URL=
# Legacy base64 32-byte AES key for voiceprints, separate from meeting-content keys.
KATIP_VOICEPRINT_KEY=

# Privacy, retention and usage limits
# Post notice in chat, read it in voice too, or off; default chat.
KATIP_PRIVACY_NOTICE_ON_JOIN=chat
# Installation privacy/rights contact; empty falls back to the organizer.
KATIP_PRIVACY_CONTACT=
# Truthful Turkish server-location sentence; cannot be empty or contain control characters.
KATIP_PRIVACY_SERVER_LOCATION=Katip şu an için yurt dışındaki sunucularda çalışmaktadır
# Human-readable retention wording; empty derives from retention_days.
KATIP_RETENTION_TEXT=
# Meeting-data retention days; 0 disables automatic deletion.
KATIP_RETENTION_DAYS=365
# Separate diagnostic artifact retention in days.
KATIP_DEBUG_RETENTION_DAYS=7
# Post a signed report link in the meeting chat when ready.
KATIP_POST_REPORT_TO_CHAT=true
# Save meeting HTML/screenshots routinely; join failures can still create diagnostics when false.
KATIP_AUTO_DIAGNOSE=false
# Maximum bot duration in tam meeting mode.
KATIP_MAX_MEETING_MINUTES=90
# tam for interactive agent, voice and translation; kayit for quiet transcript/report mode.
KATIP_DEFAULT_MODE=tam
# Maximum bot duration in kayit mode.
KATIP_RECORD_MAX_MINUTES=600
# Silence timeout for leaving in kayit mode.
KATIP_RECORD_IDLE_LEAVE_MINUTES=60
# Leave when no other visible participant and no speech for this duration.
KATIP_ALONE_LEAVE_MINUTES=5
# Rotate a Soniox streaming connection before its duration limit.
KATIP_STT_ROTATE_MINUTES=280
# Application meeting concurrency cap; size hardware separately.
KATIP_MAX_CONCURRENT_BOTS=1
# Daily cumulative bot-minute budget.
KATIP_DAILY_MEETING_MINUTES=660
# Live LLM request cap per meeting.
KATIP_MAX_AGENT_CALLS_PER_MEETING=60
# Presentation narration request cap per meeting; nonnegative.
KATIP_PRESENTATION_NARRATIONS_PER_MEETING=80
# Interactive-mode silence timeout; 0 disables.
KATIP_IDLE_LEAVE_MINUTES=15
# Legacy threshold for separating mixed enrollment voice clusters.
KATIP_VOICE_MIXED_MAX_SIMILARITY=0.5
# Legacy minimum segment duration for voice matching.
KATIP_VOICE_SEGMENT_MIN_S=2.0
# Legacy minimum share of the smaller voice cluster.
KATIP_VOICE_MIXED_MIN_SHARE=0.25
# Accept ingest only from local clients in the legacy co-located topology.
KATIP_INGEST_LOCAL_ONLY=false

# Speech recognition and language
# Speech provider used when stt_chain is empty.
KATIP_STT_PROVIDER=soniox
# Soniox STT/TTS credential.
SONIOX_API_KEY=
# Soniox streaming transcription model identifier.
KATIP_SONIOX_MODEL=stt-rt-v5
# Soniox transcription WebSocket URL; rewritten for EU selection.
KATIP_SONIOX_WS_URL=wss://stt-rt.soniox.com/transcribe-websocket
# us or eu endpoints; EU requires provider-side account enablement.
KATIP_SONIOX_REGION=us
# Speech endpointing delay in milliseconds; provider supports 500–3000.
KATIP_SONIOX_MAX_ENDPOINT_DELAY_MS=1000
# Installation vocabulary hints, e.g. product terms; JSON array.
KATIP_STT_TERMS='[]'
# Deepgram credential, used only when explicitly selected.
DEEPGRAM_API_KEY=
# Primary speech language code.
KATIP_SOURCE_LANG=tr
# Translation target language code; empty disables translation.
KATIP_TARGET_LANG=en
# Capture PCM sample rate in Hz; keep pipeline format consistent.
KATIP_SAMPLE_RATE=16000
# Capture frame size in milliseconds; frame_samples is derived, not an environment variable.
KATIP_FRAME_MS=20

# Infrastructure, workers, parser and bot
# SQLAlchemy async database URL: SQLite or PostgreSQL with asyncpg.
KATIP_DATABASE_URL=sqlite+aiosqlite:///data/katip.db
# API bind address for launchers that read this setting; Compose uses its explicit uvicorn command.
KATIP_API_HOST=0.0.0.0
# API port for launchers; Compose explicitly binds 8000.
KATIP_API_PORT=8000
# Browser worker ingest WebSocket endpoint.
KATIP_INGEST_WS_URL=ws://localhost:8000/ws/ingest
# local subprocess, docker manager in process, or remote manager lease queue.
KATIP_BOT_BACKEND=local
# Browser worker image tag; build it before launching meetings.
KATIP_BOT_IMAGE=katip-worker:local
# Optional required worker image digest; pin after validating an image.
KATIP_BOT_IMAGE_DIGEST=
# Docker network joined by dynamic browser workers.
KATIP_BOT_NETWORK=katip-workers
# API ingest URL reachable from dynamic workers.
KATIP_BOT_WORKER_INGEST_URL=ws://api:8000/ws/ingest
# Per-worker memory limit, 256–16384 MiB.
KATIP_BOT_MEMORY_MB=1024
# Per-worker CPU quota, 0.25–16.
KATIP_BOT_CPUS=1.0
# Block browser requests to private networks; complements host firewall rules.
KATIP_BOT_BLOCK_PRIVATE_NETWORK=true
# Manager-ID to secret mapping on API; independent secret per manager.
KATIP_WORKER_MANAGER_KEYS='{}'
# Worker lease duration, 30–300 seconds.
KATIP_WORKER_LEASE_S=60
# Maximum queued-job wait, 30–3600 seconds.
KATIP_WORKER_QUEUE_TIMEOUT_S=300
# Worker disconnect grace period, 15–300 seconds.
KATIP_BOT_DISCONNECT_TIMEOUT_S=60
# Control API URL used by a remote manager; HTTPS required except configured internal hostname.
KATIP_WORKER_API_URL=
# Single explicitly permitted internal Compose HTTP hostname.
KATIP_WORKER_API_INTERNAL_HOSTNAME=
# Remote manager identity, matching API manager mapping.
KATIP_WORKER_MANAGER_ID=
# Remote manager credential; use a random value of at least 32 characters.
KATIP_WORKER_MANAGER_KEY=
# Upload limit in bytes, 1024–16777216.
KATIP_DOCUMENT_MAX_BYTES=8388608
# Maximum preparation documents per meeting, 1–20.
KATIP_DOCUMENT_MAX_PER_MEETING=8
# Maximum document context characters passed to live answers, 2000–60000.
KATIP_DOCUMENT_CONTEXT_CHARS=24000
# Document parsing timeout, 1–60 seconds.
KATIP_DOCUMENT_PARSER_TIMEOUT_S=20
# Isolated parser service URL; configure for uploaded untrusted documents.
KATIP_PARSER_URL=
# Parser authentication credential.
KATIP_PARSER_KEY=
# Parser authentication file path, preferred for Compose.
KATIP_PARSER_KEY_FILE=
# Installation-configurable browser and full Teams display name; default Katip.
KATIP_BOT_DISPLAY_NAME=Katip
# on fails closed; auto may fall back without Chromium sandbox; off disables it.
KATIP_BOT_SANDBOX=on
# Enable Chromium site isolation; keep true in production.
KATIP_BOT_SITE_ISOLATION=true
# Run browser headless; worker image normally supplies a virtual display.
KATIP_BOT_HEADLESS=false
# Maximum wait to join/admit bot from meeting lobby in seconds.
KATIP_BOT_JOIN_TIMEOUT_S=900
# Reserved Monday integration credential; no complete public Monday workflow is shipped.
MONDAY_API_TOKEN=

# Isolated Compose interpolation inputs (required before docker compose up).
# Unique PostgreSQL password; URL-encode it in KATIP_DATABASE_URL above.
POSTGRES_PASSWORD=
# Docker socket group ID from: stat -c %g /var/run/docker.sock
KATIP_DOCKER_GID=
# Optional worker network override.
KATIP_WORKER_NETWORK=katip-workers
# For isolated Compose, replace KATIP_DATABASE_URL with PostgreSQL URL,
# and set absolute host paths in KATIP_DATA_KEY_FILE and KATIP_PARSER_KEY_FILE.
# Set panel domains, bootstrap email/hash, provider keys and privacy fields.
# No safe universal production values exist for these installation secrets.
